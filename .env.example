# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# The application reads these as ENVIRONMENT VARIABLES. run.sh loads .env for you.
# Keep the quotes: they protect characters such as & and $ in URLs and passwords.

# Optional - this is the default if you leave it out:
CAMPUSFIX_DB_URL="jdbc:mysql://localhost:3306/campusfix?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"

# Required - a MySQL account that can read/write the campusfix database:
CAMPUSFIX_DB_USER="campusfix_app"
CAMPUSFIX_DB_PASSWORD='change-me'

# Optional - set to true to print stack traces for unexpected errors:
CAMPUSFIX_DEBUG="false"
